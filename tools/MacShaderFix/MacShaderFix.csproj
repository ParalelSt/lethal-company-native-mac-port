<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>netstandard2.1</TargetFramework><AssemblyName>MacShaderFix</AssemblyName><LangVersion>9</LangVersion><Nullable>disable</Nullable><DebugType>none</DebugType><Version>1.1.0</Version><GenerateAssemblyInfo>false</GenerateAssemblyInfo>
<!-- Set UnityManaged to <built app>/Contents/Resources/Data/Managed and BepInExCore to a BepInEx 5 core folder, e.g. dotnet build -p:UnityManaged=... -p:BepInExCore=... -->
<UnityManaged Condition="'$(UnityManaged)'==''"></UnityManaged>
<BepInExCore Condition="'$(BepInExCore)'==''"></BepInExCore></PropertyGroup>
<ItemGroup>
<Reference Include="BepInEx"><HintPath>$(BepInExCore)/BepInEx.dll</HintPath></Reference>
<Reference Include="0Harmony"><HintPath>$(BepInExCore)/0Harmony.dll</HintPath></Reference>
<Reference Include="UnityEngine"><HintPath>$(UnityManaged)/UnityEngine.dll</HintPath></Reference>
<Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManaged)/UnityEngine.CoreModule.dll</HintPath></Reference>
<Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(UnityManaged)/UnityEngine.AssetBundleModule.dll</HintPath></Reference>
</ItemGroup></Project>
